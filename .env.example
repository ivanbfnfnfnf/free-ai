# ================= Arena IDE / Arena API =================
# Скопируйте этот файл в .env и при желании поправьте значения.

# --- HTTP-сервер (OpenAI-совместимый прокси) ---
ARENA_HOST=127.0.0.1
ARENA_PORT=8081

# --- Для IDE (arena_cli.py) ---
ARENA_API_URL=http://localhost:8081
# Модель по умолчанию (полный список: python arena_api.py --models или /models в IDE)
ARENA_DEFAULT_MODEL=gemini-3.8-flash-high

# --- Браузер (транспорт) ---
# Путь к браузеру (по умолчанию ищется Chrome -> Edge -> Brave автоматически)
# ARENA_BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Порт DevTools и профиль браузера (сессия входа живёт здесь)
# ARENA_DEBUG_PORT=9223
# ARENA_PROFILE_DIR=

# --- Продвинутые (обычно менять не нужно) ---
# ARENA_BASE_URL=https://arena.ai
# ARENA_RECAPTCHA_SITEKEY=6LeTGMcsAAAAALuIlkVwIxaAuZA8VledA6d3Nnb0
# ARENA_RECAPTCHA_ACTION=chat_submit
